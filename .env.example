# Copy to .env.local and fill in.

# Port the dev/prod server runs on. Change and restart to switch ports.
PORT=3013

# Public site URL (used for metadata, OG, canonical). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3013

# Contact form → your Gmail via Web3Forms (free, 250/mo).
# 1) Go to https://web3forms.com, enter your email (ar3991492@gmail.com), get an Access Key.
# 2) Paste it below. That's it — the form on the site will email you.
NEXT_PUBLIC_WEB3FORMS_KEY=
